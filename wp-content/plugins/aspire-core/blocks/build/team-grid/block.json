{
  "apiVersion": 3,
  "name": "aspire-core/team-grid",
  "version": "1.0.0",
  "title": "Team Grid",
  "category": "aspirecre",
  "icon": "groups",
  "description": "Published Aspire team members.",
  "textdomain": "aspire-core",
  "attributes": {
    "count": {
      "type": "integer",
      "default": 4,
      "minimum": 1,
      "maximum": 8
    },
    "presentation": {
      "type": "string",
      "enum": [
        "classic",
        "editorial"
      ],
      "default": "classic"
    },
    "hideWhenEmpty": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "aspire-core-block-editor",
  "editorStyle": "aspire-core-block-editor"
}
